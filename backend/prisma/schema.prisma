generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String         @unique
  password     String?
  role          Role           @default(USER)
  isOAuth       Boolean        @default(false)
  provider     String?
  createdAt    DateTime       @default(now())
  budgets       Budget[]
  notifications Notification[]
  transactions  Transaction[]
  accounts     Account[]
  transfers    Transfer[]
}

model Transaction {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  amount    Float
  type      String   // "income" | "expense"
  category  String
  note      String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  userId    String   @db.ObjectId

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
}

model Budget {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  amount    Float
  category  String
  month     String   // "2026-03"
  userId    String   @db.ObjectId
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, month])
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id])
  
  @@map("notifications")
}

model Account {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String    @db.ObjectId
  name          String
  type          String    // "bank" | "cash" | "investment" | "credit_card" | "wallet" | "other"
  balance      Float     @default(0)
  currency     String    @default("INR")
  institution  String?
  accountNumber String?
  isActive     Boolean   @default(true)
  asOfDate     DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now())
  
  user         User      @relation(fields: [userId], references: [id])
  transfersFrom Transfer[] @relation("TransferFromAccount")
  transfersTo   Transfer[] @relation("TransferToAccount")
  
  @@index([userId])
  @@index([userId, type])
}

model Transfer {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId
  fromAccountId    String    @db.ObjectId
  toAccountId     String    @db.ObjectId
  amount         Float
  currency       String    @default("INR")
  fee            Float     @default(0)
  status         String    @default("pending") // "pending" | "completed" | "failed"
  notes          String?
  date           DateTime  @default(now())
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
  
  fromAccount    Account  @relation("TransferFromAccount", fields: [fromAccountId], references: [id])
  toAccount      Account  @relation("TransferToAccount", fields: [toAccountId], references: [id])
  user           User     @relation(fields: [userId], references: [id])
  
  @@index([userId, createdAt(sort: Desc)])
  @@index([fromAccountId])
  @@index([toAccountId])
}

enum Role {
  USER
  ADMIN
}
