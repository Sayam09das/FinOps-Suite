generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Transaction {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  amount    Float
  type      String
  category  String
  date      DateTime
  userId    String   @db.ObjectId
}

model Budget {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  limit     Float
  category  String
  month     String
  userId    String   @db.ObjectId
}
