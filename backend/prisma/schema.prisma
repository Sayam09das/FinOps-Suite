generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String         @unique
  password     String?
  role          Role           @default(USER)
  isOAuth       Boolean        @default(false)
  provider     String?
  createdAt    DateTime       @default(now())
  budgets       Budget[]
  notifications Notification[]
  transactions  Transaction[]
  accounts     Account[]
  transfers    Transfer[]
  savingsGoals  SavingsGoal[]
  debts         Debt[]
  investments   Investment[]
}

model Transaction {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  amount    Float
  type      String   // "income" | "expense"
  category  String
  note      String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  userId    String   @db.ObjectId

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
}

model Budget {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  amount    Float
  category  String
  month     String   // "2026-03"
  userId    String   @db.ObjectId
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, month])
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id])
  
  @@map("notifications")
}

model Account {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String    @db.ObjectId
  name          String
  type          String    // "bank" | "cash" | "investment" | "credit_card" | "wallet" | "other"
  balance      Float     @default(0)
  currency     String    @default("INR")
  institution  String?
  accountNumber String?
  isActive     Boolean   @default(true)
  asOfDate     DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now())
  
  user         User      @relation(fields: [userId], references: [id])
  transfersFrom Transfer[] @relation("TransferFromAccount")
  transfersTo   Transfer[] @relation("TransferToAccount")
  
  @@index([userId])
  @@index([userId, type])
}

model Transfer {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId
  fromAccountId    String    @db.ObjectId
  toAccountId     String    @db.ObjectId
  amount         Float
  currency       String    @default("INR")
  fee            Float     @default(0)
  status         String    @default("pending") // "pending" | "completed" | "failed"
  notes          String?
  date           DateTime  @default(now())
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
  
  fromAccount    Account  @relation("TransferFromAccount", fields: [fromAccountId], references: [id])
  toAccount      Account  @relation("TransferToAccount", fields: [toAccountId], references: [id])
  user           User     @relation(fields: [userId], references: [id])
  
  @@index([userId, createdAt(sort: Desc)])
  @@index([fromAccountId])
  @@index([toAccountId])
}

model SavingsGoal {
  id             String               @id @default(auto()) @map("_id") @db.ObjectId
  userId         String               @db.ObjectId
  name           String
  targetAmount   Float
  currentAmount  Float                @default(0)
  deadline       DateTime
  linkedAccount  String
  color          String               @default("#3B82F6")
  icon           String               @default("Shield")
  currency       String               @default("INR")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  user           User                 @relation(fields: [userId], references: [id])
  contributions  SavingsContribution[]

  @@index([userId, createdAt(sort: Desc)])
}

model SavingsContribution {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  goalId         String      @db.ObjectId
  date           DateTime    @default(now())
  amount         Float
  createdAt      DateTime    @default(now())

  goal           SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, date(sort: Desc)])
}

model Debt {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  userId           String        @db.ObjectId
  name             String
  type             String
  totalAmount      Float
  remainingBalance Float
  interestRate     Float
  emi              Float
  color            String        @default("#F59E0B")
  currency         String        @default("INR")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user             User          @relation(fields: [userId], references: [id])
  payments         DebtPayment[]

  @@index([userId, createdAt(sort: Desc)])
}

model DebtPayment {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  debtId      String   @db.ObjectId
  date       DateTime @default(now())
  amount     Float
  type       String
  createdAt  DateTime @default(now())

  debt       Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([debtId, date(sort: Desc)])
}

model Investment {
  id              String              @id @default(auto()) @map("_id") @db.ObjectId
  userId          String              @db.ObjectId
  name            String
  type            String
  investedAmount  Float
  currentValue    Float
  quantity        Float
  buyPrice        Float
  color           String              @default("#2563EB")
  currency        String              @default("INR")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user            User                @relation(fields: [userId], references: [id])
  history         InvestmentHistory[]

  @@index([userId, createdAt(sort: Desc)])
}

model InvestmentHistory {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  investmentId  String      @db.ObjectId
  date          DateTime    @default(now())
  value         Float
  createdAt     DateTime    @default(now())

  investment    Investment  @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@index([investmentId, date(sort: Desc)])
}

enum Role {
  USER
  ADMIN
}
